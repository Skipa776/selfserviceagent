# Copy this file to .env and fill in only the integrations you need.
# .env is gitignored. Never commit real credentials.
#
# Stage 1 needs NONE of these. `npm test`, `npm run demo` and the whole request
# path run with this file absent. Unconfigured integrations degrade to local
# implementations so a clean checkout remains testable.
#
# Unset, buildStage2() wires the keyword parser and the service answers at
# keyword-parser quality. That is not an error, and parsed audit lines record
# parseSource: 'keyword' so it is visible rather than silent.

# Base URL, no trailing slash. The client appends /chat/completions. The hosted LLM
# provider is the intended provider, but another bearer-authenticated OpenAI-compatible
# endpoint can be used for parsing. The provider's /utils/token_counter is required by
# the multi-model token benchmark.
LLM_API_URL=

# Sent as `Authorization: Bearer <key>`. Never commit a real value.
LLM_API_KEY=

# The model id, exactly as the provider names it. Record it alongside any
# accuracy number. Prefer a lightweight parsing model. The tested recommendation
# is gemini-3.5-flash-lite; model IDs depend on the configured provider.
LLM_MODEL=

# Optional. Milliseconds; defaults to 10000. A hung parse must become a keyword
# parse quickly — the user is waiting, and a fast honest answer beats a slow one.
# LLM_TIMEOUT_MS=10000


# ServiceNow PDI or approved university ServiceNow REST Table API connection.
#
# Unset, buildStage2() files into the in-memory sink. That degradation is LESS
# visible than the LLM one — the in-memory sink returns realistic-looking ticket
# numbers and nothing in the reply distinguishes them from real records. Run
# `npm run snow:check` before believing a filing was real.
#
# Before any of this works, create five String columns on the `task` table
# (incident and sc_request both inherit from it):
#   u_service  u_scope  u_symptom  u_location  u_reporter_hash
# `npm run snow:check` verifies they exist and names any that are missing.
#
# PDIs hibernate after ~10 days idle — wake yours at developer.servicenow.com.

# No trailing slash and no path. The adapter appends /api/now/table/...
SNOW_INSTANCE_URL=

# Basic auth over HTTPS for a local PDI demo. Production authentication requires
# an approved least-privilege integration account and authentication method.
SNOW_USER=
SNOW_PASSWORD=

# Optional. Defaults incident / sc_request.
# sc_request records are normally born from the catalog ordering flow; if a
# direct Table API create is rejected (commonly a mandatory requested_for), set
# SNOW_REQUEST_TABLE=incident and u_scope still tells the two classes apart.
# SNOW_INCIDENT_TABLE=incident
# SNOW_REQUEST_TABLE=sc_request

# Read scope. Defaults to service_owned, which reads only active records filed by
# this service (correlation_display=campus-issue-reporter).
#
# DEMO / READ-ONLY OPTION ONLY: all_tagged also reads active records created by
# other means, but only when they carry the required integration metadata. Those
# records are peer-report evidence, never an authoritative IT incident or status.
# It does not read arbitrary untagged IT incidents. Keep service_owned for the
# production-safe default.
# SNOW_READ_SCOPE=service_owned

# Optional. Milliseconds; defaults to 15000.
# SNOW_TIMEOUT_MS=15000

# Local presentation caller only. Prefer `npm run web:presentation`, which sets
# this for the process. It rotates a synthetic identity after each accepted normal
# submission so one presenter can represent distinct reporters. Never enable it
# for production callers; production identity must come from authentication.
# WEB_PRESENTATION=1

# Experimental AI analyst demo.
# Runs a separate loopback-only operator surface. This profile currently supports
# evidence aggregation, LLM recommendations, and shadow approval only. Generalized
# ServiceNow creation is not implemented in the analyst process.
# ANALYST_PORT=4100
# ANALYST_OPERATOR_TOKEN=generate-a-long-random-value
# ANALYST_DB_PATH=.analyst-demo.sqlite

# Comma-separated LLM model IDs for `npm run eval:models`. Every model is run
# against the same synthetic corpus. No model is automatically promoted.
# ANALYST_MODELS=model-a,model-b
# ANALYST_BENCHMARK_OUTPUT=analyst-model-benchmark.json
